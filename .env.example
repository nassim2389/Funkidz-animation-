# =============================================================================
# Funkidz Animation — variables d'environnement
# =============================================================================
# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env est ignoré par Git : aucun secret ne doit être commité.
# =============================================================================

# --- Django -----------------------------------------------------------------
DEBUG=True
SECRET_KEY=changez-cette-valeur-en-production

# URL de base utilisée dans les liens des e-mails
SITE_URL=http://127.0.0.1:8000


# --- E-mails : choix du backend ----------------------------------------------
# Trois modes possibles.
#
# 1) Console (mode par défaut si rien n'est configuré)
#    Les e-mails sont affichés dans le terminal qui exécute runserver.
#    EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# 2) Fichier — pratique pour une démonstration sans compte SMTP.
#    Chaque e-mail est écrit dans un fichier lisible du dossier indiqué.
#    EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
#    EMAIL_FILE_PATH=sent_emails
#
# 3) SMTP réel — pour recevoir les e-mails dans de vraies boîtes.
#    Renseigner EMAIL_HOST suffit à activer le backend SMTP.
#    EMAIL_HOST=smtp-relay.brevo.com
#    EMAIL_PORT=587
#    EMAIL_USE_TLS=True
#    EMAIL_USE_SSL=False
#    EMAIL_HOST_USER=identifiant-smtp
#    EMAIL_HOST_PASSWORD=mot-de-passe-smtp        # NE JAMAIS COMMITER
#    EMAIL_TIMEOUT=10

# Expéditeur affiché dans les e-mails
DEFAULT_FROM_EMAIL=Funkidz Animation <contact@funkidz.fr>


# --- E-mails : destinataires --------------------------------------------------
# Adresses recevant les notifications ADMINISTRATIVES (nouvelle réservation,
# paiement confirmé, annulation, message de contact, demande de congé).
# Plusieurs adresses possibles, séparées par des virgules.
# Si la variable est vide, les destinataires sont déduits des comptes ayant
# le rôle ADMIN ou is_superuser=True, plus l'adresse de DEFAULT_FROM_EMAIL.
# ADMIN_NOTIFICATION_EMAILS=admin-de-test@exemple.fr
#
# Les notifications CLIENT partent vers l'adresse du compte qui a réservé
# (Booking.user.email) et les notifications ANIMATEUR vers l'adresse du compte
# animateur affecté (BookingAssignment.animateur.user.email).
# Ces deux adresses ne se configurent pas ici : elles se règlent en créant ou
# en modifiant les comptes correspondants dans /admin/users/user/.


# --- Stripe -------------------------------------------------------------------
# STRIPE_API_KEY=                                  # NE JAMAIS COMMITER
# STRIPE_WEBHOOK_SECRET=                           # NE JAMAIS COMMITER


# --- Google OAuth (connexion « Se connecter avec Google ») --------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=                            # NE JAMAIS COMMITER
